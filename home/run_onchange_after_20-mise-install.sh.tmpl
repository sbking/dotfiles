{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/sh
set -eu

# mise config checksum: {{ include "dot_config/mise/config.toml" | sha256sum }}

if [ -d "$HOME/.local/bin" ]; then
  PATH="$HOME/.local/bin:$PATH"
  export PATH
fi

if command -v mise >/dev/null 2>&1; then
  mise install
fi
{{- end }}
