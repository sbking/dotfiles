{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/sh
set -eu

if ! command -v fish >/dev/null 2>&1; then
  echo "Skipping default shell setup: fish is not installed."
  exit 0
fi

if ! command -v chsh >/dev/null 2>&1; then
  echo "Skipping default shell setup: chsh is not available."
  exit 0
fi

fish_path="$(command -v fish)"
user_name="${USER:-$(id -un)}"

print_manual_steps() {
  cat <<EOF
Fish is installed at $fish_path, but the default-shell setup needs an
interactive password prompt. Run these commands from a terminal:

  printf '%s\\n' '$fish_path' | sudo tee -a /etc/shells >/dev/null
  chsh -s '$fish_path' '$user_name'
EOF
}

if ! grep -qxF "$fish_path" /etc/shells; then
  if ! [ -t 0 ] && ! sudo -n true 2>/dev/null; then
    print_manual_steps
    exit 0
  fi

  printf '%s\n' "$fish_path" | sudo tee -a /etc/shells >/dev/null
fi

current_shell=""
{{ if eq .chezmoi.os "darwin" -}}
if command -v dscl >/dev/null 2>&1; then
  current_shell="$(dscl . -read "/Users/$user_name" UserShell 2>/dev/null | awk '{print $2}')"
fi
{{ else if eq .chezmoi.os "linux" -}}
if command -v getent >/dev/null 2>&1; then
  current_shell="$(getent passwd "$user_name" | cut -d: -f7)"
fi
{{- end }}

if [ -z "$current_shell" ]; then
  current_shell="${SHELL:-}"
fi

if [ "$current_shell" = "$fish_path" ]; then
  exit 0
fi

if ! chsh -s "$fish_path" "$user_name"; then
  print_manual_steps
  exit 0
fi
{{- end }}
