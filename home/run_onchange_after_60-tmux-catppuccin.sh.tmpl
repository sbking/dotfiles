#!/bin/sh
set -eu

plugin_dir="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/catppuccin/tmux"
plugin_version="v2.3.0"

if ! command -v git >/dev/null 2>&1; then
  echo "Skipping Catppuccin tmux setup: git is not installed."
  exit 0
fi

if [ -d "$plugin_dir/.git" ]; then
  git -C "$plugin_dir" fetch --tags --force origin
else
  mkdir -p "$(dirname "$plugin_dir")"
  git clone https://github.com/catppuccin/tmux.git "$plugin_dir"
fi

git -C "$plugin_dir" checkout --detach "$plugin_version"
