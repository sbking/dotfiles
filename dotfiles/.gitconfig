[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	dark = true
	navigate = true
	side-by-side = true
	syntax-theme = Catppuccin Mocha

[merge]
	conflictStyle = zdiff3

[diff]
	colorMoved = default

[include]
	path = ~/.gitconfig.local

[init]
	defaultBranch = main

[fetch]
	prune = true

[pull]
	ff = only

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
